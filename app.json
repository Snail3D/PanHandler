{
  "expo": {
    "name": "PanHandler",
    "slug": "panhandler",
    "scheme": "panhandler",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./icon.png",
    "splash": {
      "image": "./assets/pan-handler-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "description": "PanHandler - Precise CAD measurements from photos. Use coins for calibration, measure distances, angles, areas, and export to CAD software.",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.vibecode.panhandler-83ilg2",
      "infoPlist": {
        "NSCameraUsageDescription": "PanHandler uses the camera to capture reference photos for measurements.",
        "NSPhotoLibraryUsageDescription": "PanHandler accesses your photo library to import photos for measurement.",
        "NSPhotoLibraryAddUsageDescription": "PanHandler saves measurement images to your photo library.",
        "NSMotionUsageDescription": "PanHandler uses motion data for tilt detection and level alignment.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "6754727828"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.snail.panhandler",
      "versionCode": 29,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PanHandler needs photo library access to save measurements and export images.",
          "cameraPermission": "PanHandler needs camera access to capture photos for measurement."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "PanHandler needs photo library access to save measurements and export images.",
          "savePhotosPermission": "PanHandler needs permission to save measurement images to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-mail-composer"
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "enableProguardInReleaseBuilds": true,
            "useAndroidX": true,
            "enableJetifier": true,
            "blockedPermissions": [
              "android.permission.ACTIVITY_RECOGNITION",
              "android.permission.ACCESS_COARSE_LOCATION",
              "android.permission.ACCESS_FINE_LOCATION",
              "android.permission.ACCESS_MEDIA_LOCATION",
              "android.permission.ACCESS_NETWORK_STATE",
              "android.permission.SYSTEM_ALERT_WINDOW",
              "android.permission.USE_BIOMETRIC",
              "android.permission.USE_FINGERPRINT",
              "com.android.vending.CHECK_LICENSE",
              "android.permission.RECORD_AUDIO"
            ],
            "usesFeature": {
              "android.hardware.camera": true
            }
          }
        }
      ],
      "./plugins/withRemoveActivityRecognition.js",
      "./plugins/withNoARCore.js",
      "./plugins/withExcludeFormFactors.js"
    ],
    "extra": {
      "eas": {
        "projectId": "2698e824-55c8-4e16-af52-f59bde50cdd9"
      }
    }
  }
}
