{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "EXPO_NO_CAPABILITY_SYNC": "1"
      },
      "ios": {
        "distribution": "store"
      },
      "android": {
        "distribution": "store",
        "buildType": "app-bundle",
        "autoIncrement": true,
        "gradleCommand": ":app:bundleRelease"
      },
      "cache": {
        "disabled": true,
        "customPaths": ["patches"]
      }
    },
    "production-clean": {
      "extends": "production",
      "android": {
        "distribution": "store",
        "buildType": "apk",
        "autoIncrement": false
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6754577499"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    }
  }
}
